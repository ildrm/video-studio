# Local development image. Cloud media isolation is a separate deployment concern.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --no-audit --no-fund --workspace @studio/api --include=dev
COPY apps/api ./apps/api
RUN npm run build --workspace @studio/api

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg python3 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/studio \
    && chown node:node /var/lib/studio
COPY --from=build --chown=node:node /app /app
COPY --chown=node:node docs/03-frontend/schemas/project-v1.schema.json ./docs/03-frontend/schemas/project-v1.schema.json
COPY --chown=node:node workers/media ./workers/media
USER node
ENV API_HOST=0.0.0.0 PORT=4000 STORAGE_ROOT=/var/lib/studio \
    MEDIA_WORK_ROOT=/var/lib/studio MEDIA_WORKER_SCRIPT=/app/workers/media/media_worker.py \
    PYTHON_BIN=python3 FFMPEG_PATH=/usr/bin/ffmpeg FFPROBE_PATH=/usr/bin/ffprobe \
    FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    FONT_LICENSE_PATH=/usr/share/doc/fonts-dejavu-core/copyright
EXPOSE 4000
CMD ["sh", "-c", "node apps/api/dist/migrate.js && exec node apps/api/dist/server.js"]
