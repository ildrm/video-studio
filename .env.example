# Local development only. Copy to .env and fill in fresh random values.
# Generate each value separately, for example: openssl rand -hex 32
# Compose refuses to start when these are blank. Use URL-safe hex values.
POSTGRES_PASSWORD=
SESSION_SECRET=

# Local password accounts and an embedded media process are development-only.
# Set to true for the local end-to-end workflow; both default to false.
AUTH_LOCAL_ENABLED=false
MEDIA_LOCAL_ENABLED=false

# Optional host ports; all published ports bind to localhost.
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5433

# The browser uses the web origin; web forwards /v1 requests to the API.
APP_ORIGIN=http://localhost:3000

# For host-run API development, set DATABASE_URL and absolute storage paths
# in your shell. The Compose file supplies container-specific settings.
# DATABASE_URL=postgresql://studio:<url-encoded-password>@127.0.0.1:5433/studio
# STORAGE_ROOT=/absolute/path/to/private/studio-storage
# MEDIA_WORK_ROOT=/absolute/path/to/private/studio-storage
# MEDIA_WORKER_SCRIPT=/absolute/path/to/workers/media/media_worker.py
# PYTHON_BIN=python3
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Caption font installation copies this trusted font into private workspace storage.
# Docker images supply DejaVu Sans and its exact package license notices.
# FONT_PATH=/absolute/path/to/DejaVuSans.ttf
# FONT_LICENSE_PATH=/absolute/path/to/font-copyright-notices.txt
